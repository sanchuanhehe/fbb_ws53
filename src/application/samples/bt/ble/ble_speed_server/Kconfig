config BLE_SPEED_TEST
    bool
    prompt "Set the sample support speed test"
    depends on SAMPLE_SUPPORT_BLE_SPEED_SERVER_SAMPLE
    default y
    help
        Enable continuous notification throughput mode. Disable it to use
        write-and-indicate loopback mode.
