<configuration>
    <oatconfig>
        <licensefile></licensefile>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="license" name="Apache-2.0" 
                            path="!.*LICENSE" rule="may" group="defaultGroup" 
                            filefilter="defaultPolicyFilter" desc=""/>
                <policyitem type="license" name="BSD-3-Clause" 
                            path="src/kernel/liteos/liteos_v208.5.0/Huawei_LiteOS/.*"
                            rule="may" group="defaultGroup" filefilter="liteosPolicyFilter" desc=""/>
                <policyitem type="copyright" name="HiSilicon (Shanghai) Technologies Co., Ltd."
                            path=".*" rule="may" group="defaultGroup"
                            filefilter="copyrightPolicyFilter" desc="HiSilicon (Shanghai) copyright"/>
                <policyitem type="copyright" name="Huawei Technologies Co., Ltd."
                            path="src/kernel/liteos/liteos_v208.5.0/Huawei_LiteOS/.*" 
                            rule="may" group="defaultGroup"
                            filefilter="liteosPolicyFilter" desc="Huawei Technologies copyright"/>
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter" desc="Filters for compatibility, license header policies">
                <filteritem type="filename" name="README"/>
                <filteritem type="filename" name="COPYRIGHT|COPYRIGHT.OpenSource"/>
                <filteritem type="filename" name="*.code-workspace"/>
                <filteritem type="filename" name="*.dox|*.xml|*.xsd|*.py|*.sh|*.mk|*.mak|*.make|*.inl|*.sym|*.csv"/>
                <filteritem type="filepath" name="src/open_source/.*" desc="Exclude opesource"/>
                <filteritem type="filepath" name="src/tools/bin/compiler/.*"/>
                <filteritem type="filepath" name="src/kernel/liteos/liteos_v208.5.0/Huawei_LiteOS/.*"/>
                <filteritem type="filepath" name="src/drivers/chips/ws53/rom/app/open_source/.*"/>
                <filteritem type="filepath" name="src/drivers/chips/ws53/rom/romboot/open_source/.*"/>
                <filteritem type="filepath" name="src/middleware/services/wifi_service/hostapd/liteos_hostapd_src/.*"/>
            </filefilter>
            <filefilter name="copyrightPolicyFilter" desc="Filters for copyright header policies" >
                <filteritem type="filename" name="README"/>
                <filteritem type="filename" name="*.dox|*.xml|*.xsd|*.py|*.sh|*.mk|*.mak|*.make|*.inl|*.sym|*.csv"/>
                <filteritem type="filename" name="*.code-workspace"/>
                <filteritem type="filepath" name="src/kernel/liteos/liteos_v208.5.0/.*"/>
                <filteritem type="filepath" name="src/open_source/.*"/>
                <filteritem type="filepath" name="src/tools/bin/compiler/.*"/>
                <filteritem type="filepath" name="src/drivers/chips/ws53/rom/app/open_source/.*"/>
            </filefilter>
            <filefilter name="binaryFileTypePolicyFilter" desc="Filters for binary file policies" >
                <filteritem type="filename" name="*.a|*.so|*.bin|*.ko" desc="Shared libraries of Hisilicon self-developed platform"/>
                <filteritem type="filename" name="sign_tool_pltuni.exe|sign_tool_pltuni" desc="sign tool"/>
                <filteritem type="filename" name="lzma_tool.exe|lzma_tool|tool_security" desc="build tool"/>
                <filteritem type="filepath" name="src/open_source/.*" desc="Exclude Opensource"/>
                <filteritem type="filepath" name="src/tools/bin/compiler/.*" desc="Exclude compiler"/>
            </filefilter>
            <filefilter name="liteosPolicyFilter" desc="Filters for compatibility, license header policies">
                <filteritem type="filepath" name=".*" desc="Exclude liteos"/>        
                <filteritem type="filepath" name="open_source/.*" desc="Exclude opesource"/>
            </filefilter>
        </filefilterlist>
    </oatconfig>
</configuration>
